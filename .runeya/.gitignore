
#################
# Do not edit this file #
#################


# Encryption key (contains secrets — never commit)
.encryption.key
.encryption.key.enc


# Key verification canary — MUST be committed so new team members can validate their encryption key
!.runeya-verify

# This machine's cloud session token (encrypted, and specific to this install)
cloud-session.json

# Backup in local only
backup-*

# Per-user environment overrides (never commit — each dev has their own)
environment-overrides.json

# Private user data (conversations, personal state — never commit)
*.private
*.private.json*
conversations/
conversations.private.json



# Runtime logs
*.log
*.log.*
